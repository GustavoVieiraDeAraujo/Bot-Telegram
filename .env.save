TOKEN_BOT=seu_token_aqui

# Providers de afiliados ativos, separados por virgula (ex.: aliexpress,outrarede)
PROVIDERS=aliexpress

# Credenciais do provider AliExpress (necessarias somente se "aliexpress" estiver em PROVIDERS)
ALIEXPRESS_CHAVE_APP=sua_chave
ALIEXPRESS_SEGREDO_APP=seu_segredo
ALIEXPRESS_ID_RASTREAMENTO=seu_id

# IDs numericos (separados por virgula) dos usuarios que veem o menu administrador
ADMIN_USER_IDS=

# Caminho para o JSON com botoes extras do menu administrador (opcional)
ADMIN_LINKS_PATH=config/admin_links.json

# Nome exibido nas mensagens do bot
BOT_DISPLAY_NAME=Bot de Afiliados

# Caminhos para imagens de boas-vindas e de desconto de carrinho (opcionais, sem imagem o bot usa texto)
WELCOME_IMAGE_PATH=
CART_IMAGE_PATH=

LINK_TELEGRAM_CHAT=https://t.me/seu_chat
LINK_TELEGRAM_OFERTAS=https://t.me/seu_ofertas
LINK_YOUTUBE=https://youtube.com/seu_canal
URL_WEBHOOK=https://seudominio.com/webhook
PORT=8080
